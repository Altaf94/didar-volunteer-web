# In `npm start`, the UI calls this API host for all requests (not localhost:3000).
# Enable CORS for http://localhost:3000 on your API.
REACT_APP_API_URL=http://127.0.0.1:8001

# Production: leave unset = relative /api/... on Vercel + rewrites. Set to 0 to call
# REACT_APP_API_URL (Heroku) from the browser; Heroku CORS must allow your Vercel site.
# REACT_APP_SAME_ORIGIN_API=0
