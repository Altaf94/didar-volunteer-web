# ——— Local development (Create React App) ———
# First matching file wins (see node_modules/react-scripts/config/env.js): .env.development.local,
# then .env.local, then .env.development, then .env. If you still see port 8000, remove or
# update REACT_APP_API_URL in .env.local / .env.development.local, then restart `npm start`.
# The repo’s `.env.development` uses 8001. Your API must allow CORS from http://localhost:3000.
REACT_APP_API_URL=http://127.0.0.1:8001

# Volunteer list + dashboard + dispatch list (GET /api/volunteers, …/dashboard/stats, …/dispatch-packages).
# Omit or set to 0 to skip those requests and use empty in-app data. Set to true when the backend implements them.
# REACT_APP_VOLUNTEER_HTTP_LIST_DASHBOARD=true

# ——— Direct browser → API (optional) ———
# Leave commented for same-origin + proxy (dev) and Vercel rewrites (prod).
# Set to 0 to have the app call `REACT_APP_API_URL` from the browser (no proxy path).
# Production on Vercel: set to your Heroku API origin, e.g. https://my-app.herokuapp.com
# (no trailing slash). The API must list your Vercel site in CORS_ORIGINS (or equivalent).
# REACT_APP_SAME_ORIGIN_API=0

# If REACT_APP_SAME_ORIGIN_API=0 and REACT_APP_API_URL is 127.0.0.1/localhost, set:
# REACT_APP_ALLOW_LOCAL_API=1

# ——— Vercel (build-time: set in Project → Environment Variables) ———
# Preview + Production if using direct mode:
#   REACT_APP_SAME_ORIGIN_API=0
#   REACT_APP_API_URL=https://<your-heroku-app>.herokuapp.com
# If you keep same-origin (relative /api) instead, the client uses vercel.json rewrites
# to your API: update the `destination` in vercel.json if your Heroku app URL changes.
